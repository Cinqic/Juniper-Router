{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "example_id", "split", "curriculum_family", "lineage_id", "messages", "registry", "policy", "expected_decision", "source", "review_status", "quality_flags", "difficulty", "risk_tags", "renderer_version", "content_sha256"],
  "properties": {"schema_version": {"const": "juniper-router-example-v1"}, "example_id": {"type": "string"}, "split": {"enum": ["train", "dev", "test", "adversarial"]}, "curriculum_family": {"type": "string"}, "lineage_id": {"type": "string"}, "messages": {"type": "array", "minItems": 1}, "registry": {"$ref": "router-registry-v1.schema.json"}, "policy": {"type": "object"}, "expected_decision": {"$ref": "router-decision-v1.schema.json"}, "source": {"type": "object"}, "review_status": {"type": "string"}, "quality_flags": {"type": "array"}, "difficulty": {"type": "string"}, "risk_tags": {"type": "array"}, "renderer_version": {"enum": ["chatml-v1", "chatml-router-compact-v1"]}, "content_sha256": {"pattern": "^[a-f0-9]{64}$"}}
}
