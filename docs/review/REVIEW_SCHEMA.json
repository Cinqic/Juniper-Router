{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_commit", "artifact_manifest", "reviewer", "verdict", "findings", "tests", "session"],
  "properties": {"candidate_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "artifact_manifest": {"type": "string"}, "reviewer": {"enum": ["astra", "sol"]}, "verdict": {"enum": ["APPROVE", "REQUEST_CHANGES", "REJECT"]}, "findings": {"type": "array"}, "tests": {"type": "array"}, "session": {"type": "object"}}
}
