{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cinqic/Juniper-Router/schemas/router-input-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "user_text", "registry", "policy", "trusted_result", "context"],
  "properties": {"schema_version": {"const": "juniper-router-input-v1"}, "user_text": {"type": "string", "minLength": 1, "maxLength": 32000}, "registry": {"$ref": "router-registry-v1.schema.json"}, "policy": {"type": "object"}, "trusted_result": {"type": ["object", "null"]}, "context": {"type": "array", "maxItems": 128}}
}
